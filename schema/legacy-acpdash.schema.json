{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:closeout:legacy-acpdash:1",
  "title": "Legacy ACPDash closeout policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "items"],
  "properties": {
    "version": { "const": 1 },
    "retry": { "type": "object" },
    "items": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
          "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
          "run": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "hint": { "type": "string" },
          "skill": { "type": "string", "minLength": 1, "maxLength": 256 },
          "providers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "differentProvider": { "type": "boolean" },
          "failOn": { "enum": ["P0", "P1", "P2", "P3"] },
          "phase": { "type": "string", "minLength": 1, "maxLength": 64 },
          "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    }
  }
}
