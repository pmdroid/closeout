{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:closeout:policy:0.1",
  "title": "Closeout policy document, draft 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion"],
  "properties": {
    "specVersion": { "const": "0.1" },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempts_per_check": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "fix_rounds_per_item": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "narrow_after_lines": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "maxFailedAttemptsPerItem": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "scope": { "enum": ["task", "candidate"] },
        "maxFailedReviewAttempts": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "imports": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "as"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 256 },
          "as": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/item" }
    },
    "setup": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/setupStep" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/rule" }
    },
    "rerun": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "conflict": {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "run": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "reviews": { "type": "boolean" }
          }
        },
        "ci": {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "run": { "enum": ["all", "failed"] }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "item": {
      "oneOf": [
        { "$ref": "#/$defs/command" },
        { "$ref": "#/$defs/review" },
        { "$ref": "#/$defs/evidence" },
        { "$ref": "#/$defs/preview" }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": { "except": ["paths"] },
      "required": ["id", "kind", "gate", "exec", "timeoutSeconds"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "kind": { "const": "command" },
        "gate": { "const": "beforePR" },
        "exec": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "except": { "$ref": "#/$defs/paths" },
        "paths": { "$ref": "#/$defs/paths" },
        "ci": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$" },
        "recheck": { "type": "boolean" },
        "since": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runner"],
          "properties": {
            "runner": { "enum": ["bun", "vitest", "jest", "pytest", "go", "cargo", "nextest"] },
            "always": {
              "type": "array",
              "maxItems": 256,
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "full_on": { "$ref": "#/$defs/paths" },
            "max_selected": { "type": "integer", "minimum": 1, "maximum": 100000 }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": { "except": ["paths"] },
      "required": ["id", "kind", "gate", "skill", "independence", "failOn"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "kind": { "const": "review" },
        "gate": { "const": "beforePR" },
        "skill": { "type": "string", "minLength": 1, "maxLength": 256 },
        "independence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["differentSession", "differentModel"],
          "properties": {
            "differentSession": { "type": "boolean" },
            "differentModel": { "type": "boolean" }
          }
        },
        "failOn": { "enum": ["P0", "P1", "P2", "P3"] },
        "scope": { "enum": ["candidate", "diff"] },
        "parallel": { "type": "boolean" },
        "minChangedLines": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "except": { "$ref": "#/$defs/paths" },
        "paths": { "$ref": "#/$defs/paths" },
        "recheck": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": { "except": ["paths"] },
      "required": ["id", "kind", "gate"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "kind": { "const": "evidence" },
        "gate": { "const": "beforePR" },
        "media": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["image", "video"] }
        },
        "minimum": { "type": "integer", "minimum": 1, "maximum": 100 },
        "hint": { "type": "string", "minLength": 1, "maxLength": 500 },
        "approval": { "const": "human" },
        "except": { "$ref": "#/$defs/paths" },
        "paths": { "$ref": "#/$defs/paths" },
        "recheck": { "type": "boolean" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": { "except": ["paths"] },
      "required": ["id", "kind", "gate", "approval"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "kind": { "const": "preview" },
        "gate": { "const": "beforePR" },
        "approval": { "const": "human" },
        "hint": { "type": "string", "minLength": 1, "maxLength": 500 },
        "except": { "$ref": "#/$defs/paths" },
        "paths": { "$ref": "#/$defs/paths" },
        "recheck": { "type": "boolean" }
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": { "except": ["paths"] },
      "required": ["id", "probe", "summary", "failOn"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "probe": { "type": "string", "minLength": 1, "maxLength": 256 },
        "exec": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n]+$" },
        "except": { "$ref": "#/$defs/paths" },
        "paths": { "$ref": "#/$defs/paths" },
        "failOn": { "enum": ["P0", "P1", "P2", "P3"] },
        "onFail": { "enum": ["fix", "approve"] },
        "recheck": { "type": "boolean" }
      }
    },
    "setupStep": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": { "except": ["paths"] },
      "required": ["id", "exec", "timeoutSeconds"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "exec": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "except": { "$ref": "#/$defs/paths" },
        "paths": { "$ref": "#/$defs/paths" }
      }
    }
  }
}
